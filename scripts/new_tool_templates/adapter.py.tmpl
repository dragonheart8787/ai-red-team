"""{{Name}} adapter -- DRAFT generated by scripts/new_tool_scaffold.py.

THIS FILE IS NOT A DECISION ABOUT {{NAME}}. It is the part of an adapter that is
the same for every tool, with every part that is a judgement left as
``NotImplemented`` -- which is not a ``bool`` and not a ``str``, so
``tests/adapter_kit.adapter_violations`` refuses it until a person has answered.

Before filling anything in, write ``docs/ADR_{{NAME}}.md`` from
``docs/templates/ADR_NEW_TOOL_TEMPLATE.md``. The constants below are the code
form of that document's answers, not a substitute for it: the D42-1 answer
("an ad_domain scope authorizes collection, never action") and the D43-4 answer
("a snippet is redacted before a model reads it") were reached by asking what
the tool's data actually is, and no scaffold can ask that.

Every ``DECIDE(<id>)`` marker names the section of docs/NEW_TOOL_ONBOARDING.md
that says how to answer it, and the precedent the answer has to be consistent
with.
"""

from __future__ import annotations

from collections.abc import Mapping
from dataclasses import dataclass
from typing import Any

TOOL = "{{name}}"
ACTION = "{{action}}"
IMAGE = "cyberorch/{{name}}:local"

#: DECIDE(version) -- onboarding §4. Pin exactly, and keep equal to the
#: ``{{NAME}}_VERSION`` build arg in tool_gateway/images/{{name}}.Dockerfile.
#: ``tool_version()`` returns this constant and must never probe a binary on the
#: control-plane host: the tool lives in the image, not on this machine
#: (D43 ab2849a; the same defect is still in ad_collector.py, ACCEPTANCE 5.30).
{{NAME}}_VERSION = NotImplemented

#: DECIDE(side_effects) -- onboarding §3. Does running this tool write to, or
#: change the state of, the target? Read the *built command*, not the tool's
#: marketing: the registry looks these up from the action so a Worker cannot
#: claim less (D34), and OPA escalates on them. A wrong ``False`` understates
#: what the tool does to a target; nothing downstream can correct it.
WRITES_DATA = NotImplemented
CHANGES_STATE = NotImplemented

#: DECIDE(classification) -- onboarding §1. Whether this action must have a known
#: data classification before it runs is decided by the action's **name** in
#: control_plane/policy/rego/authz.rego (``requires_known_classification``), and by
#: nothing about the tool. Fact at scaffold time, for ``{{action}}``:
{{CLASSIFICATION_FACT}}
#: State ``"required"`` or ``"exempt: <reason, at least 20 characters>"``. Not a
#: default: ``tests/adapter_kit.classification_violations`` compares your answer
#: with the rule, so ``"required"`` for a name the rule does not cover fails (the
#: gate would silently never apply), and ``"exempt"`` is a person accepting that
#: skip on the record. Until this line is an answer, the name passed to ``--action`` is a
#: string somebody typed, not a decision.
KNOWN_CLASSIFICATION = NotImplemented

#: DECIDE(egress) -- onboarding §3/§4. True: the tool speaks HTTP(S) and must go
#: through the egress proxy (D34). False: raw TCP/UDP confined by the network
#: namespace (nmap), or no network at all (Semgrep, D43-5). Not a default in
#: either direction.
REQUIRES_PROXY = NotImplemented

#: DECIDE(dispatch) -- onboarding §3. ``"dispatch_scan"`` is the generic
#: single-target path. A tool that needs a step before or after the sandbox run
#: (D42's graph write, D43's control-plane git fetch and cleanup) needs its own
#: dispatch function; routing such a tool through ``dispatch_scan`` starts its
#: container with nothing mounted (D45). Name the function, and see
#: tests/test_dispatch_routing.py.
NEEDS_DISPATCH = NotImplemented

#: Writable tmpfs mounts over the sandbox's read-only root. Leave ``None`` until
#: the image self-check or a first run shows the tool writing somewhere (Semgrep
#: wrote ~/.semgrep; Chromium wrote a whole profile). The tighter default is
#: fine: a tool that needs one fails loudly, not quietly (onboarding §4).
TMPFS: dict[str, str] | None = None

TOOL_STOP_GRACE_SECONDS = 5


class AdapterError(ValueError):
    """The capability cannot be turned into a run of this tool."""


@dataclass(frozen=True)
class {{Name}}Plan:
    """What will actually be executed, before it is executed."""

    command: tuple[str, ...]
    target: str
    max_duration_seconds: int

    def as_params(self) -> dict[str, Any]:
        """Normalized parameters for the §7 execution fingerprint.

        DECIDE(fingerprint) -- onboarding §5. Every input that changes what the
        tool does or sees belongs here, or in ``execution_context``, or in
        ``tool_version`` / ``ruleset_version``. Leaving one out makes the system
        decide a scan is already done and skip it: a security bug, not a
        performance one (§7, D11-3). ``max_duration_seconds`` is deliberately
        absent -- a budget change is not a different scan of the same target --
        but that is true only while the budget does not change what the tool
        observes. ``tests/adapter_kit.fingerprint_violations`` makes you
        account for every input ``build_plan`` reads.
        """
        return {"target": self.target}


def tool_version() -> str:
    """The pinned version, for the §7 fingerprint. Never a host probe."""
    if not isinstance({{NAME}}_VERSION, str) or not {{NAME}}_VERSION:
        raise NotImplementedError("DECIDE(version): pin {{NAME}}_VERSION")
    return f"{TOOL}-{{{NAME}}_VERSION}"


def build_plan(
    *, constraints: Mapping[str, Any], budget: Mapping[str, Any], target: str,
) -> {{Name}}Plan:
    """Turn a capability into a command.

    ``constraints`` arrive from a *proposal* through
    ``function_api.execution_constraints`` -- so every key read here must be
    carried there, or it is silently dropped on the real path (D37, D45). The
    contract test reads this function's source and checks.
    """
    if not target:
        raise AdapterError("no target")
    max_duration = int(budget.get("max_duration_seconds", 600))
    if max_duration <= 0:
        raise AdapterError("max_duration_seconds must be positive")

    # DECIDE(command) -- onboarding §4/§5. Build the argv from validated inputs
    # only. Things that have bitten before: a tool's own network calls (version
    # check, telemetry, registry fetches) hang under ``--network none`` rather
    # than failing fast, so switch them off *in the command*, never as an option
    # a caller could omit (D43); a secret must never appear in argv (D50).
    raise NotImplementedError("DECIDE(command): build the argv for {{NAME}}")


def derive_view(stdout: str, stderr: str, *, truncated_at: int = 4000) -> dict[str, Any]:
    """Build the §4.4 derived view -- the only thing a model is shown.

    DECIDE(evidence) -- onboarding §6. The default shows a model **none** of the
    tool's output, only its size: the safe direction, and deliberately useless.
    Replace it with the smallest view that lets the Worker do its job, having
    answered, in the ADR: is this output third-party (untrusted) content? Can it
    hold a secret the reader must not see (redact before it leaves this module,
    D43-4)? Is it unbounded (cap it, D40/5.21)? Does it name addresses (extract
    them for discovery only, D20)?
    """
    return {
        "untrusted_content": True,
        "stdout_bytes": len(stdout.encode("utf-8", "replace")),
        "stderr_bytes": len(stderr.encode("utf-8", "replace")),
        "output_withheld": "DECIDE(evidence): no view has been designed for this tool yet",
    }
