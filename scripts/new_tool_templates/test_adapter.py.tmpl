def test_a_lure_cannot_be_authorized(engagement_id, registry):
    # The property is about what a Worker does NEXT with an address it read, so the
    # action tested is the follow-on one, not necessarily this tool's. If this tool's
    # targets are not addresses (a repository, a domain), test a network action on the
