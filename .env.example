# Copy to .env, or just run scripts/init_db.sh — it generates random passwords
# and writes .env for you. .env is gitignored; this file holds placeholders only
# and must never contain a real credential.

# Runtime connection. The cyberorch_app role: NOSUPERUSER, NOBYPASSRLS, owner of
# no table, so RLS applies to it (§8.6).
DATABASE_URL=postgresql+psycopg://cyberorch_app:CHANGE_ME@127.0.0.1:5432/cyberorch

# Migration connection. Used only by alembic; owns the tables.
MIGRATION_DATABASE_URL=postgresql+psycopg://migration_owner:CHANGE_ME@127.0.0.1:5432/cyberorch
