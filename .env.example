# Copy to .env, or just run scripts/init_db.sh — it generates random passwords
# and writes .env for you. .env is gitignored; this file holds placeholders only
# and must never contain a real credential.

# Runtime connection. The cyberorch_app role: NOSUPERUSER, NOBYPASSRLS, owner of
# no table, so RLS applies to it (§8.6).
DATABASE_URL=postgresql+psycopg://cyberorch_app:CHANGE_ME@127.0.0.1:5432/cyberorch

# Migration connection. Used only by alembic; owns the tables.
MIGRATION_DATABASE_URL=postgresql+psycopg://migration_owner:CHANGE_ME@127.0.0.1:5432/cyberorch

# Engagement Manager connection (§5). The only role that may write
# scope_registry and metadata_registry. Same RLS and engagement boundary as
# cyberorch_app -- a writer, not an administrator.
REGISTRY_ADMIN_DATABASE_URL=postgresql+psycopg://registry_admin:CHANGE_ME@127.0.0.1:5432/cyberorch

# The reconciler's plan-side connection (D64, migration 0023). The reconciler_reader role holds
# EXECUTE on two SECURITY DEFINER functions and no privilege on any table.
RECONCILER_READER_DATABASE_URL=postgresql+psycopg://reconciler_reader:CHANGE_ME@127.0.0.1:5432/cyberorch

# --- The reconciler's thresholds (D64-3, D64-5). Every one is required: the reconciler refuses to
# start with any missing, and never guesses. Seconds, whole numbers. The values below are the design's
# recommendations (docs/D64_RECONCILER_DESIGN.md §1.2) with the derivation of each; the code also
# refuses a value below the least it implies (control_plane/reconciler/config.py).

# How long a proposal may sit at `received` (then it is abandoned) or `decided` (then it is closed)
# before the reconciler acts. At least 300 = twice the longest honest decision stage (reviewer 120 s +
# OPA 30 s); chosen, not derived: long enough for a caller's retry to find its proposal.
RECONCILER_STAGE_GRACE_S=3600

# How long after a capability's lease has lapsed a `capability_issued` proposal is closed. Not a safety
# parameter: a live driver takes the stage with a conditional update and whoever commits first wins.
RECONCILER_LEASE_GRACE_S=30

# How long after an approval's valid_until an unserved `approved` proposal is closed.
RECONCILER_APPROVAL_GRACE_S=30

# The cap on a capability's max_duration_seconds as the reconciler judges it: min(budget, cap). At
# least the Rego ceiling (control_plane/policy/ceiling.py), three times the largest budget in use.
RECONCILER_B_CAP_S=1800

# The longest a dispatch with an egress proxy spends before its container runs: 15 Docker calls at the
# client's 60 s timeout, plus the proxy's 15 s readiness wait. Read from tool_gateway/sandbox.py.
RECONCILER_P_PROXY_S=915

# The longest such a dispatch spends after its container ended: 5 Docker calls at 60 s.
RECONCILER_Q_PROXY_S=300

# The longest the control plane's own kill() may take: a container still running this long past
# StartedAt + budget has outlived its owner's ability to stop it.
RECONCILER_KILL_MARGIN_S=60

# The most the host's clock may differ from the Docker daemon's. Every age of a container or a network
# is the daemon's StartedAt / Created against this host's "now", so a skew of s seconds moves every
# deadline by s; beyond this nothing that kills or removes a Docker object is asked for, and the
# pass says why (report docker_clock_skewed, or docker_clock_unknown when the daemon will not say).
# At most a quarter of KILL_MARGIN_S (so 15 with the value above); 5 is far above the milliseconds
# measured on one machine and far below a drifted VM clock. The database's clock is never compared
# with the host's (docs/D64_CLOCKS.md).
RECONCILER_MAX_CLOCK_SKEW_S=5

# How long an exited or never-started tool container is kept (its output is the only evidence of what
# ran) before it is removed.
RECONCILER_RETENTION_S=86400

# How long a sandbox network with no container of any state attached must have been idle before it is
# removed. Far longer than a dispatch's own setup time.
RECONCILER_NETWORK_IDLE_S=3600

# How often the sweep of idle networks runs (the service, step 6d). Bounds the count of networks; it
# does not prevent an overlap failure, for which no sweep is a cure.
RECONCILER_NETWORK_SWEEP_PERIOD_S=86400

# After a kill, a removal or an unlink, how long the act half waits to *see* the change (the container
# stopped, the object gone) before it calls the action failed. A reply of "done" is not the fact.
RECONCILER_VERIFY_WAIT_S=10

# How often the service writes its failure summary (reconciler.failure_summary): at most once per
# period, and only if something failed in it. A failed action is audited once per object and reason per
# process; this is how often anyone hears of the repeats.
RECONCILER_SUMMARY_PERIOD_S=3600
# How long a kill, removal or unlink that FAILED is left alone on the same object by the same process
# (D64 item 4). Every attempt writes an intent record and makes a Docker call; a persistently failing
# object (Docker refusing, a volume that will not detach) would otherwise do both every pass. 30 min.
RECONCILER_RETRY_AFTER_FAILURE_S=1800
# How much of a backlog one pass takes on (D64 pre-deletion item 6). The stuck-proposals function returns
# 5,000 rows a page; a pass reads at most MAX_PAGES pages (20 = 100,000 rows) and says "truncated" if the
# last is still full. It carries out at most MAX_ACTIONS_PER_PASS actions (each is its own transaction), so
# a backlog after an outage is worked off in passes that can be stopped between, not in one long one.
RECONCILER_MAX_PAGES=20
RECONCILER_MAX_ACTIONS_PER_PASS=500
# After a pass that was truncated or limited and still did nothing, the wait before the next doubles, up to
# this (15 min). Any pass that is neither resets it. A pass that does something never slows down.
RECONCILER_BACKOFF_MAX_S=900

# A sandbox network whose range blocked a refused run may be removed (migration 0025; D64 pre-deletion
# §3). The window is how long a refusal counts; the minimum idle time must not be below
# B_CAP_S + P_PROXY_S + Q_PROXY_S (3015 with the values above); the cap is removals of one blocking
# network by one process per 24 h. Nothing is removed while the deletion flag is off.
RECONCILER_NETWORK_CONFLICT_WINDOW_S=86400
RECONCILER_NETWORK_CONFLICT_MIN_IDLE_S=3600
RECONCILER_NETWORK_CONFLICT_DAILY_CAP=3
